# Build context for apps/api/Dockerfile. The API copies three things — its
# manifest, its lockfile and its source — so everything else is context it
# would otherwise ship to the builder on every commit.

.git
.gitignore
.gitattributes

# Both apps carry their own install tree; the image builds its own.
node_modules
**/node_modules
**/dist
**/*.tsbuildinfo
**/.DS_Store

# The API never reads the frontend, the schema or the book.
apps/web
supabase
BOOK
docs
scripts
*.md
**/*.md

# Env files are supplied by the platform at runtime. Bun auto-loads a .env from
# the working directory, so a baked-in value is a bug waiting to happen.
.env
**/.env
**/.env.local
**/.env.*.local
**/*.log
