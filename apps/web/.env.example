# Copy to .env.local and fill in. Both Supabase values are client-safe: the
# publishable key is designed to ship to browsers and is still subject to RLS.

# Supabase project URL — Project Settings -> API -> Project URL
# Publishable key — the same page, labelled "Publishable key"
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the ElysiaJS API. Leave blank to use the Vite dev proxy on /api.
VITE_API_BASE_URL=

# The browser's mirror of the API's APP_ENV / APP_DEBUG. It has to be VITE_
# prefixed because that is the only prefix Vite exposes to client code — the
# frontend is not allowed to read APP_ENV itself, and the API never sees these.
# Committed values are production. Local development belongs in
# .env.development.local (loaded for `vite dev` only, gitignored):
#   VITE_APP_ENV=development
#   VITE_APP_DEBUG=true
# Keeping them mode-scoped matters: a value in .env.local would win during a
# build too, and a build made with development values would ship a page that
# prints stacks. On a deploy host, set these in the process environment — a
# real environment variable always beats the file.
VITE_APP_ENV=production
VITE_APP_DEBUG=false
