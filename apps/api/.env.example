# Copy to .env. The API needs no credentials: iTunes Search API is free and
# unauthenticated, and messages go straight to Supabase from the browser.

# Production values. APP_ENV=production forces every verbose path off, so
# APP_DEBUG=true inside a production file still cannot turn detail back on.
# For local development, put the opposite in .env.local instead:
#   APP_ENV=development
#   APP_DEBUG=true
APP_ENV=production
APP_DEBUG=false

PORT=8787

# The only origin allowed to call this API cross-origin (CORS). During
# development the Vite proxy makes requests same-origin, so this does nothing
# locally. On a deploy, set it to the frontend's origin — for example
# ALLOWED_ORIGIN=https://your-app.pages.dev. An exact match is required; the
# value is never echoed back for any other Origin and never becomes `*`.

# Optional: Upstash Redis behind the rate limiter (src/rateLimit.ts). Both
# values empty — or absent — means the limiter is off, which is the default
# for a process started without this file. Real values belong in .env.local
# (gitignored) or, on a deploy, in the environment — never in git:
#   UPSTASH_REDIS_REST_URL=https://<database>.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=<token>
